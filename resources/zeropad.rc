#include <windows.h>
#include <commctrl.h>
#include "resource.h"
#include "zeropad_version.h"
1 RT_MANIFEST "zeropad.manifest"
IDI_ZEROPAD ICON "zeropad.ico"
1 VERSIONINFO
 FILEVERSION ZEROPAD_VERSION_TUPLE
 PRODUCTVERSION ZEROPAD_VERSION_TUPLE
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
#ifdef _DEBUG
 FILEFLAGS VS_FF_DEBUG
#else
 FILEFLAGS 0
#endif
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE 0
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "FileDescription", "ZeroPad controller-to-keyboard utility\0"
            VALUE "FileVersion", ZEROPAD_FILE_VERSION_STRING "\0"
            VALUE "InternalName", "ZeroPad\0"
            VALUE "OriginalFilename", "ZeroPad.exe\0"
            VALUE "ProductName", "ZeroPad\0"
            VALUE "ProductVersion", ZEROPAD_VERSION_STRING "\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
IDD_SETTINGS DIALOGEX 0, 0, 380, 345
STYLE DS_SETFONT | WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_THICKFRAME | WS_MINIMIZEBOX
EXSTYLE WS_EX_APPWINDOW
CAPTION "ZeroPad - Settings"
FONT 9, "Segoe UI"
BEGIN
    LTEXT "&Controller:", IDC_CONTROLLER_LABEL, 8, 8, 50, 12
    COMBOBOX IDC_CONTROLLER, 65, 8, 100, 90, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT "Status: Checking", IDC_STATUS, 175, 8, 120, 14
    AUTOCHECKBOX "&Enable keyboard mapping", IDC_ENABLED, 8, 28, 180, 14, WS_TABSTOP
    CONTROL "Bindings", IDC_BINDINGS, "SysListView32", LVS_REPORT | LVS_SINGLESEL | LVS_SHOWSELALWAYS | WS_BORDER | WS_TABSTOP, 8, 48, 364, 140
    PUSHBUTTON "Change &Key...", IDC_CHANGE, 8, 190, 75, 16
    PUSHBUTTON "C&lear Binding", IDC_CLEAR, 90, 190, 75, 16
    GROUPBOX "Analog settings", IDC_ANALOG_GROUP, 8, 210, 364, 65
    LTEXT "Stick &press:", IDC_STICK_PRESS_LABEL, 16, 225, 60, 12
    EDITTEXT IDC_STICK_PRESS, 78, 223, 55, 14, ES_AUTOHSCROLL | WS_TABSTOP
    LTEXT "Stick &release:", IDC_STICK_RELEASE_LABEL, 160, 225, 65, 12
    EDITTEXT IDC_STICK_RELEASE, 228, 223, 55, 14, ES_AUTOHSCROLL | WS_TABSTOP
    LTEXT "Trigger p&ress:", IDC_TRIGGER_PRESS_LABEL, 16, 250, 60, 12
    EDITTEXT IDC_TRIGGER_PRESS, 78, 248, 55, 14, ES_AUTOHSCROLL | WS_TABSTOP
    LTEXT "Trigger re&lease:", IDC_TRIGGER_RELEASE_LABEL, 160, 250, 65, 12
    EDITTEXT IDC_TRIGGER_RELEASE, 228, 248, 55, 14, ES_AUTOHSCROLL | WS_TABSTOP
    LTEXT "&Polling interval:", IDC_POLL_LABEL, 8, 282, 75, 12
    EDITTEXT IDC_POLL, 90, 280, 45, 14, ES_NUMBER | ES_AUTOHSCROLL | WS_TABSTOP
    LTEXT "ms (1-100)", IDC_MS, 140, 282, 65, 12
    PUSHBUTTON "&Defaults", IDC_DEFAULTS, 8, 320, 55, 17
    PUSHBUTTON "&Reload...", IDC_RELOAD, 68, 320, 55, 17
    PUSHBUTTON "Res&ume", IDC_RESUME, 128, 320, 55, 17
    PUSHBUTTON "Cancel", IDCANCEL, 245, 320, 55, 17
    DEFPUSHBUTTON "&Save", IDOK, 308, 320, 64, 17
    LTEXT "", IDC_NOTICE, 8, 300, 364, 18
END
IDD_BINDING DIALOGEX 0, 0, 265, 155
STYLE DS_SETFONT | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Assign Keyboard Key"
FONT 9, "Segoe UI"
BEGIN
    LTEXT "Focus the capture button and press one key. Escape cancels.", IDC_CAPTURE_PROMPT, 8, 8, 249, 22
    PUSHBUTTON "Press a key here...", IDC_CAPTURE, 8, 35, 249, 22, WS_TABSTOP
    LTEXT "Selected: None yet", IDC_SELECTED, 8, 62, 249, 16
    PUSHBUTTON "&Choose Key...", IDC_CHOOSE, 8, 82, 85, 17
    LTEXT "Or select a &key:", IDC_KEYS_LABEL, 8, 106, 80, 12
    COMBOBOX IDC_KEYS, 94, 103, 163, 110, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    PUSHBUTTON "Cancel", IDCANCEL, 136, 130, 55, 17
    DEFPUSHBUTTON "&Assign", IDOK, 199, 130, 58, 17
END
